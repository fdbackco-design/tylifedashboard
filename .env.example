# ─────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────────
# TY Life 외부 시스템 연동
# ─────────────────────────────────────────────
# 외부 TY Life 시스템 베이스 URL
TYLIFE_BASE_URL=https://your-tylife-system.example.com

# 세션 쿠키 (실제 로그인 후 브라우저 개발자도구에서 복사)
# 형식: "SESSION_ID=xxxx; OTHER_COOKIE=yyyy"
# 코드에서는 TYLIFE_COOKIE 또는 TYLIFE_SESSION_COOKIE 둘 다 인식합니다.
# 절대 이 파일에 실제 값을 저장하지 마세요
TYLIFE_COOKIE=
# TYLIFE_SESSION_COOKIE=   # (선택) 위와 동일 — 레거시 이름

# 서버 직접 로그인(권장): 설정되면 브라우저 쿠키보다 우선 사용합니다.
TYLIFE_ID=
TYLIFE_PW=
# 브라우저 Network 요청의 User-Agent 전체 값
TYLIFE_USER_AGENT=

# 동기화 기본 설정
TYLIFE_SYNC_PAGE_SIZE=50
TYLIFE_SYNC_RATE_LIMIT_MS=500
TYLIFE_SYNC_MAX_RETRIES=3

# ─────────────────────────────────────────────
# 앱 보안
# ─────────────────────────────────────────────
# 수동 sync API 보호용 비밀키 (Bearer 토큰)
SYNC_API_SECRET=your-random-secret-key

# Vercel Cron이 GET /api/cron/* 호출 시 붙이는 Bearer 값과 동일하게 설정.
# - /api/cron/tylife-sync           (10분마다)
# - /api/cron/settlement-recalculate (10분마다, 오늘 기준 정산월 자동 재계산)
# - /api/cron/notice-push           (매일 KST 11:00, 예약 공지 푸시)
# 미설정 시 SYNC_API_SECRET으로 검증한다(수동 curl 테스트 시).
CRON_SECRET=

# ─────────────────────────────────────────────
# 배포 환경
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────
# Web Push (VAPID) — Service Worker + Push API
# 생성: npx web-push generate-vapid-keys
# ─────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# mailto: 또는 https:// 사이트 URL (예: mailto:admin@example.com)
VAPID_SUBJECT=mailto:admin@your-domain.com

# ─────────────────────────────────────────────
# /admin/account-issue 구글 시트 동기화
# - Service Account 가 위 스프레드시트에 "편집자" 권한으로 공유돼 있어야 함
# - GOOGLE_PRIVATE_KEY 의 줄바꿈은 \n 으로 이스케이프된 값을 그대로 사용 (코드에서 변환)
# ─────────────────────────────────────────────
ACCOUNT_ISSUE_SHEET_ID=1d6jIx22GfRqZcXvMJ8sjNnqS3u-xOeU5_u3H62SCCZ0
ACCOUNT_ISSUE_SHEET_NAME=시트1
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXXXXXXXXXXXXXXXXXX\n-----END PRIVATE KEY-----\n"
